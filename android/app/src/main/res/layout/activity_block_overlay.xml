<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#CC000000"
    android:padding="32dp">
    <TextView android:id="@+id/tv_blocked_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:text="App Blocked"
        android:gravity="center"/>
    <TextView android:id="@+id/tv_block_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#CCFFFFFF"
        android:text="Time limit संपला"
        android:gravity="center"
        android:layout_marginTop="12dp"/>
    <Button android:id="@+id/btn_go_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Home वर जा"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00d4ff"/>
</LinearLayout>