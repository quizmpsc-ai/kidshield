# ═══════════════════════════════════════════════
# KidShield Backend — Environment Variables
# .env.example → copy to .env and fill values
# ═══════════════════════════════════════════════

# ── Server ──
PORT=3000
NODE_ENV=production

# ── Firebase Admin SDK ──
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# JSON file download होईल — खालील values त्यातून copy करा

FIREBASE_PROJECT_ID=kidshield-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kidshield-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://kidshield-xxxxx-default-rtdb.firebaseio.com

# ── Firebase Client (React Native App साठी) ──
# Firebase Console → Project Settings → Your Apps → Config
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=kidshield-xxxxx.firebaseapp.com
FIREBASE_STORAGE_BUCKET=kidshield-xxxxx.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890

# ── CORS ──
# Production मध्ये exact domain टाका, * नको
CORS_ORIGIN=https://yourusername.github.io

# ── Railway ──
# हे Railway automatically set करतो — manually नको
# RAILWAY_ENVIRONMENT=production
