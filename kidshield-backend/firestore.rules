rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users - only own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Families - parent owns, any authenticated user can write children
    // (needed for pairing - child UID != childId doc ID)
    match /families/{parentId} {
      allow read, write: if request.auth != null && request.auth.uid == parentId;
    }
    match /families/{parentId}/children/{childId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == parentId || request.auth != null);
    }
    match /families/{parentId}/children/{childId}/{subcollection=**} {
      allow read, write: if request.auth != null;
    }

    // Pairing codes
    match /pairing_codes/{code} {
      allow read, write: if request.auth != null;
    }
    match /pairingCodes/{code} {
      allow read, write: if request.auth != null;
    }

    // All other collections - authenticated users only
    match /users/{parentId}/children/{childId} {
      allow read, write: if request.auth != null;
    }
    match /usageStats/{docId} {
      allow read, write: if request.auth != null;
    }
    match /locations/{docId} {
      allow read, write: if request.auth != null;
    }
    match /appRules/{docId} {
      allow read, write: if request.auth != null;
    }
    match /commands/{docId} {
      allow read, write: if request.auth != null;
    }
    match /alerts/{docId} {
      allow read, write: if request.auth != null;
    }
    match /geofences/{docId} {
      allow read, write: if request.auth != null;
    }
    match /sosEvents/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}