rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can create pairing codes, but only read if they have the code
    match /pairingCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    
    match /pairing_codes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /children/{childId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /families/{parentId} {
      allow read, write: if request.auth != null; // Simplified for now, restrict in production
      
      match /children/{childId} {
        allow read, write: if request.auth != null;
        
        match /activity/{docId} {
          allow read, write: if request.auth != null;
        }
        match /installed_apps/{appId} {
          allow read, write: if request.auth != null;
        }
        match /blocked_domains/{domain} {
          allow read, write: if request.auth != null;
        }
        match /alerts/{alertId} {
          allow read, write: if request.auth != null;
        }
      }
    }
    
    match /commands/{commandId} {
      allow read, write: if request.auth != null;
    }
    
    match /locations/{childId} {
      allow read, write: if request.auth != null;
    }
    
    match /usageStats/{statId} {
      allow read, write: if request.auth != null;
    }
    
    match /appRules/{childId} {
      allow read, write: if request.auth != null;
    }
    
    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }
  }
}